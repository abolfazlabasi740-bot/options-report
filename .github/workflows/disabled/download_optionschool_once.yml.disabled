name: Download and inspect OptionSchool24 supplemental evidence

on:
  push:
    paths:
      - ".github/workflows/download_optionschool_once.yml"
      - "scripts/optionschool_supplemental_audit.py"

permissions:
  contents: write

jobs:
  download-and-audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Download workbook
        run: |
          set -euo pipefail
          mkdir -p data
          curl --fail --location --retry 3 --connect-timeout 20 --max-time 120 'https://s3.optionschool24.com/export/excel?type=1' -o data/optionschool24_live.xlsx
          python - <<'PY'
          from pathlib import Path
          b=Path("data/optionschool24_live.xlsx").read_bytes()
          if len(b)<5000 or not b.startswith(b"PK"): raise SystemExit("Invalid XLSX")
          print("bytes:",len(b))
          PY
          sha256sum data/optionschool24_live.xlsx | tee data/optionschool24_live.sha256
      - name: Build supplemental-only audit
        run: |
          set -euo pipefail
          python -m pip install --quiet openpyxl
          python scripts/optionschool_supplemental_audit.py
      - name: Commit source and audit
        run: |
          set -euo pipefail
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -f data/optionschool24_live.xlsx data/optionschool24_live.sha256 data/optionschool24_live_schema.json data/optionschool24_supplemental_audit.json
          git commit -m "data: archive OptionSchool24 supplemental audit"
          git push
