     1 | #!/usr/bin/env python3
     2 | # -*- coding: utf-8 -*-
     3 | """اسکنر سود لحظه آخری v2 — متدولوژی: قیمت تمام‌شده + رشد انتظاری پرمیوم
     4 | ۱) مبنا: پیش از ۱۲:۳۰ قیمت لحظه‌ای | پس از بازار قیمت پایانی همان روز
     5 | ۲) قیمت تمام‌شده = قیمت اعمال + پرمیوم
     6 | ۳) رشد ریالی سهم = مبنای سهم × درصد رشد (سناریو صف خرید)
     7 | ۴) درصد رشد انتظاری آپشن = (رشد ریالی ÷ پرمیوم) × ۱۰۰
     8 | ۵) بدون گرد کردن محاسباتی — دقت کامل در JSON و Excel
     9 | """
    10 | import requests, json, re, os, time, sys
    11 | from datetime import datetime, timezone, timedelta
    12 | 
    13 | HEADERS = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/120.0 Safari/537.36",
    14 |            "Accept": "application/json, text/plain, */*"}
    15 | IRST = timezone(timedelta(hours=3, minutes=30))
    16 | IRAN_TRADING_DAYS = {5, 6, 0, 1, 2}
    17 | OPTION_URL = "https://webgw.tse.ir/InstrumentProvider/api/v1/MarketWatch/MarketWatchTradeOption/fa"
    18 | MW_URL = "https://cdn.tsetmc.com/api/ClosingPrice/GetMarketWatch?market=0&paperTypes[0]=1&withBestLimits=false&hEven=0&RefID=0"
    19 | SEARCH_URL = "https://cdn.tsetmc.com/api/Instrument/GetInstrumentSearch?searchTerm={}"
    20 | PRICE_URL = "https://cdn.tsetmc.com/api/ClosingPrice/GetClosingPriceInfo/{}"
    21 | 
    22 | def val(obj):
    23 |     if obj is None: return None
    24 |     if isinstance(obj, dict): return obj.get("value")
    25 |     return obj
    26 | 
    27 | def now_ir(): return datetime.now(IRST)
    28 | 
    29 | def is_market_open():
    30 |     n = now_ir(); h = n.hour + n.minute / 60
    31 |     return (n.weekday() in IRAN_TRADING_DAYS) and (9 <= h <= 12.5)
    32 | 
    33 | def get_base_price(und, market_open):
    34 |     """متدولوژی بند ۱: انتخاب مبنای قیمت سهم بر اساس ساعت"""
    35 |     if market_open:
    36 |         base = und.get("last_price") or und.get("closing_price") or und.get("yesterday")
    37 |         return base, "قیمت لحظه‌ای", "realtime"
    38 |     base = und.get("closing_price") or und.get("last_price") or und.get("yesterday")
    39 |     return base, "قیمت پایانی", "closing"
