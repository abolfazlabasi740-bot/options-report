    98 | def find_underlying(option_symbol, lookup, fallback_cache, company_name=""):
    99 |     # روش ۱ (قطعی): «اختيارخ وبملت-1454-...» یا «اختیارخ ...»
   100 |     m = re.search(r'اخ[تیي]ارخ\s+(.+?)\s*-', company_name or "")
   101 |     if m:
   102 |         cand = m.group(1).strip()
   103 |         if cand in lookup and lookup[cand]["ceiling"] > 0:
   104 |             return lookup[cand]
   105 |     # روش ۲: حذف ض/ط و ارقام + کاندیداهای پیشوند
   106 |     sym = re.sub(r'^[ضط]', '', option_symbol)
   107 |     sym = re.sub(r'\d+$', '', sym).strip()
   108 |     if not sym:
   109 |         return None
   110 |     for c in [sym, f"ا{sym}", f"وب{sym}", f"خ{sym}", f"ف{sym}", f"پ{sym}", f"س{sym}", f"ش{sym}", f"گ{sym}"]:
   111 |         if c in lookup and lookup[c]["ceiling"] > 0:
   112 |             return lookup[c]
   113 |     if option_symbol not in fallback_cache:
   114 |         fallback_cache[option_symbol] = None
   115 |     return fallback_cache.get(option_symbol)
   116 | 
   117 | def calculate_option(op, und, market_open, fixed_growth=None):
   118 |     """متدولوژی v2: قیمت تمام‌شده + رشد انتظاری پرمیوم"""
   119 |     if op.get("buystateid", "") != "A": return None
   120 |     strike = val(op.get("buyQeymateEmal"))
   121 |     premium = val(op.get("buyLastPrice")) or val(op.get("buyClosingPrice"))
   122 |     days_left = val(op.get("buyBaqimandeTaSarresId"))
   123 |     volume = val(op.get("buyTradeVolume"))
   124 |     if not strike or not premium: return None
   125 |     base, basis_fa, basis_en = get_base_price(und, market_open)
   126 |     if not base or base <= 0: return None
   127 |     ceiling = und.get("ceiling", 0)
   128 |     break_even = strike + premium                      # بند ۲
   129 |     if fixed_growth is not None:                        # سناریوی درصد دلخواه (مثل 2.99)
   130 |         growth_pct = fixed_growth
   131 |         rial_growth = base * fixed_growth / 100         # بند ۳-الف
   132 |     else:
   133 |         if not ceiling or ceiling <= 0: return None     # بدون داده سقف، بدون عدد فرضی
   134 |         growth_pct = (ceiling - base) / base * 100
   135 |         rial_growth = ceiling - base
   136 |     premium_growth = (rial_growth / premium) * 100      # بند ۳-ب
   137 |     if ceiling and ceiling <= strike:
   138 |         status = "⚠️ OTM در سقف"
   139 |     elif premium_growth > 10: status = "🎯 عالی"

