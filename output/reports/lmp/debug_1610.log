=== خطوط ۷۸–۱۳۹ (find_underlying + calculate_option) ===
    78 | def search_underlying_fallback(term):
    79 |     try:
    80 |         r = requests.get(SEARCH_URL.format(term), headers=HEADERS, timeout=10); r.raise_for_status()
    81 |         for inst in r.json().get("instrumentSearch", []):
    82 |             sym = inst.get("lVal18AFC", "")
    83 |             if sym and not sym.startswith(("ض", "ط", "IR")):
    84 |                 ins_code = inst.get("insCode")
    85 |                 if ins_code: return ins_code, sym
    86 |     except: pass
    87 |     return None, None
    88 | 
    89 | def get_price_info(ins_code):
    90 |     try:
    91 |         r = requests.get(PRICE_URL.format(ins_code), headers=HEADERS, timeout=10); r.raise_for_status()
    92 |         cp = r.json().get("closingPriceInfo", {})
    93 |         return {"last_price": cp.get("pDrCotVal", 0), "closing_price": cp.get("pClosing", 0),
    94 |                 "yesterday": cp.get("priceYesterday", 0) or cp.get("yesterday", 0),
    95 |                 "ceiling": cp.get("psGelStaMax", 0), "floor": cp.get("psGelStaMin", 0)}
    96 |     except: return None
